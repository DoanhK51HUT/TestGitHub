<Window x:Class="BLEM.MouseKeyboard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BLEM.MouseKeyboard"
        mc:Ignorable="d"
        Title="BLE-Multi-MouseKeys" Height="350" Width="450"
        Icon="/Resources/WindowIcon.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <!--Title-->
        <Border Background="AntiqueWhite" Grid.Row="0">
            <TextBlock Text="Bluetooth Low Energy Multi-MouseKeyboard"
                       TextAlignment="Center"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="16"
                       Background="Transparent" Foreground="Blue"/>
        </Border>
        
        <!--Body-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <!--Select arduino port-->
            <Border Background="Aqua" Grid.Row="0">
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Arduino port"
                                VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <ComboBox x:Name="cbbArduinoPort" Grid.Column="1"
                              VerticalContentAlignment="Center"
                              DropDownOpened="cbbArduinoPort_DropDownOpened"/>
                </Grid>
            </Border>


            <!--Mode noti-->
            <TextBlock x:Name="tblSendingMode"
                       Grid.Row="1"
                       Text="Send to PC"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextAlignment="Center" FontSize="14" Foreground="Blue"
                       FontWeight="Bold"/>
            <!--Add device-->
            <Border Background="Aqua" Grid.Row="2">
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!--Combo keys for new device-->
                    <TextBlock Grid.Column="0" Text="Combo Keys"
                                VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox Grid.Column="1"/>
                    <!--BT ID for new device-->
                    <TextBlock Grid.Column="2" Text="New device ID"
                                VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBox x:Name="txtNewDeviceID"
                            Grid.Column="3"/>
                    <!--Button to add new device-->
                    <Button x:Name="btnAddNewDevice" Grid.Column="4"
                            Content="Add"/>
                </Grid>
            </Border>

            <!--List devices-->
            <ListBox x:Name="lstPairDevices" Grid.Row="3"/>

            <!--Pressed char-->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Pressed char:"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="tblPressedChar" Grid.Column="1"
                           Text="c"/>
                <TextBlock Grid.Column="2" Text="Connection status:"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="tblConnectionStatus" Grid.Column="3"
                           Text=" BLE Disconnected"/>
            </Grid>
            

        </Grid>
        
        <!--Button start-->
        <Button x:Name="btnStartButton" Grid.Row="2"
                Content="START" FontSize="14"
                Foreground="Blue"
                Click="btnStartButton_Click"/>
    </Grid>
</Window>
